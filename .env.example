# slack-channel configuration. Copy to .env and edit. The daemon and CLI both read this file
# (via SLACK_CHANNEL_ENV_FILE or SLACK_CHANNEL_DIR/.env). Real environment variables win over it.

# --- required-ish -----------------------------------------------------------------------------
# Your Slack workspace subdomain (the X in X.slack.com). Auto-detected from the Slack desktop app
# if you are signed in to exactly one workspace; set it explicitly otherwise.
# SLACK_WORKSPACE=acme

# --- who can wake your Claude -----------------------------------------------------------------
# The name of the Claude Code session a plain "@claude" is routed to (@claude:<name> targets others).
SLACK_DEFAULT_SESSION=slack

# Comma-separated Slack user IDs of colleagues who may wake your Claude by addressing "@<you>'s claude"
# — either their own Claude (robot-prefixed) or them in person. Empty = nobody but you.
# Find IDs with:  slack-channel members <channel-id>
# SLACK_PEER_USERS=U01ABCDEF,U02GHIJKL

# Stop auto-answering after this many Claude messages in a row in one thread (until a human chimes in).
SLACK_PEER_MAX_TURNS=6

# --- behaviour --------------------------------------------------------------------------------
# How many surrounding messages to include as context with each request.
SLACK_CONTEXT_MESSAGES=20

# Emoji reaction dropped on your message when a session picks the request up ("" to disable).
SLACK_ACK_REACTION=eyes

# Optional ack text posted in-thread on pickup (e.g. "on it :saluting_face:"). Empty = none.
# SLACK_ACK_TEXT=

# Where state/logs/the inbox live. Default: ~/.cache/slack-channel
# SLACK_CHANNEL_STATE_DIR=

# Advanced: the trigger regex. First capture group, if any, names the target session.
# SLACK_TRIGGER=(?i)(?:^|[\s(])@claude(?::([A-Za-z0-9._-]+))?\b

# --- auth (how it signs in as you) ------------------------------------------------------------
# By default (macOS) it reads your browser's Slack `d` cookie from the on-disk cookie DB and
# decrypts it with the matching Keychain key, then scrapes a short-lived xoxc token. You usually
# need none of the below on macOS.
#
# Keychain entry to decrypt the cookie with. Default "Chrome Safe Storage"; use "Slack Safe Storage"
# if you are signed in via the Slack desktop app, or e.g. "Chromium Safe Storage" / "Brave Safe Storage".
# SLACK_COOKIE_KEYCHAIN_SERVICE=Chrome Safe Storage
#
# Path to the browser cookie sqlite DB, if not the default Chrome Default profile.
# SLACK_COOKIE_DB=
#
# Skip the browser entirely by supplying the `d` cookie yourself (xoxd-...). REQUIRED on Linux,
# where the macOS Keychain/cookie-decryption path does not apply. Treat this like a password.
# SLACK_D_COOKIE=
